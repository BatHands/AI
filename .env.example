# Required: Hugging Face API token for model inference
HF_API_KEY=

# Optional: Override default models
# HF_EMBED_MODEL_ID=BAAI/bge-small-en-v1.5
# HF_LLM_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3

# Optional: Milvus connection URI (defaults to local file)
# MILVUS_URI=./milvus_store/milvus.db

# Optional: Text splitting parameters
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
